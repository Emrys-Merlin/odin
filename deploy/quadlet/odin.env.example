# ODIN's environment. Copy to ~/odin/odin.env on the VM (as the odin user) and fill in.
# Format: KEY=value, one per line, no quotes, no spaces around =.

# Required: ODIN's phone number in E.164 format (+49…, no spaces).
SIGNAL_NUMBER=+49XXXXXXXXXXX

# Optional overrides. Normally `odin setup` stores the group IDs in ODIN's database; while these
# are set they take precedence over it. Use the id form including the "group." prefix
# (`podman exec odin odin list-groups` prints them).
#FLAT_GROUP_ID=group.XXXXXXXX
#DINNER_GROUP_ID=group.XXXXXXXX

# Optional: DEBUG, INFO (default), WARNING, ERROR.
#ODIN_LOG_LEVEL=INFO
